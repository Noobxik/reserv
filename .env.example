# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://vpn_admin:changeme@db:5432/vpn_backup

# ── Encryption ───────────────────────────────────────────────────────────────
# 32-byte key encoded as 64 hex characters
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── JWT (admin sessions) ──────────────────────────────────────────────────────
# Any long random string
# Generate with: openssl rand -base64 48
JWT_SECRET=

# ── Admin panel ───────────────────────────────────────────────────────────────
# Plain-text password for the /admin panel login
ADMIN_SECRET=changeme

# ── Uptime Kuma webhook ───────────────────────────────────────────────────────
# Secret appended as ?secret=<value> in the Uptime Kuma notification URL
UPTIME_KUMA_SECRET=

# ── Application ───────────────────────────────────────────────────────────────
# Public base URL used by server-side fetch in /status page
NEXT_PUBLIC_BASE_URL=http://localhost:3000
